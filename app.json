{
  "expo": {
    "name": "Bolig Dialog",
    "slug": "boligdialog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/boligdialog-logo.png",
    "userInterfaceStyle": "light",
    "scheme": "boligdialog",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "no.boligdialog.app"
    },
    "android": {
      "package": "no.boligdialog.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/transperant-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "@react-native-community/datetimepicker"
    ]
  }
}
